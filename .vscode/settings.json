{
  "editor.formatOnSave": false,
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.(js|jsx|ts|tsx|mjs|cjs|mts|cts|json|jsonc|css|scss|less|html|vue|svelte|ya?ml|toml|md|mdx|graphql|gql|hbs|handlebars)$",
        "cmd": "bun fmt --no-script \"${file}\""
      }
    ]
  },
  "rust-analyzer.linkedProjects": ["apps/desktop/src-tauri/Cargo.toml"],
  "rust-analyzer.server.path": "rust-analyzer",
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[typescriptreact]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[javascript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[javascriptreact]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[json]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.promptToUseWorkspaceVersion": false,
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  }
}
