{$DOMAIN} {
	encode gzip zstd

	# Bloquear acceso externo a webhooks internos
	respond /webhooks/* 403

	reverse_proxy savecloud-api:3000
}

s3.{$DOMAIN} {
	reverse_proxy minio:9000 {
		# Las subidas prefirmadas pueden ser de gran tamaño; transmitirlas en streaming a través de Caddy sin almacenamiento en búfer.
		flush_interval -1
	}
}
