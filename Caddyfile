{$DOMAIN} {
	encode gzip zstd

	# Cabeceras de seguridad HTTP
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-XSS-Protection "1; mode=block"
	}

	# Bloquear acceso externo a webhooks internos
	handle /webhooks/* {
		respond 403
	}

	handle {
		reverse_proxy savecloud-api:3000
	}
}

s3.{$DOMAIN} {
	reverse_proxy minio:9000 {
		# Las subidas prefirmadas pueden ser de gran tamaño; transmitirlas en streaming a través de Caddy sin almacenamiento en búfer.
		flush_interval -1
	}
}
