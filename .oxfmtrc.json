{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": false,
  "semi": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "printWidth": 120,
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "useTabs": false,
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto",
  "sortPackageJson": false,
  "ignorePatterns": [
    "build",
    "coverage",
    "node_modules",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "apps/savecloud-desktop/src-tauri/target",
    "apps/savecloud-desktop/src-tauri/Cargo.lock",
    "apps/savecloud-desktop/src-tauri/Cargo.toml",
    ".agents",
    ".vscode",
    ".github",
    ".husky",
    "src-tauri"
  ]
}
