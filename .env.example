AWS_REGION=<your-aws-region>
PORT=3000
SYNC_GAMES_API_URL=<your-api-url>
SYNC_GAMES_API_KEY=<your-api-key>
USE_ACCELERATE_ENDPOINT=false

# Docker Compose VPS: copy .env.docker.example to .env and set all values below.
# Required for public HTTPS: DOMAIN, S3_PUBLIC_ENDPOINT, SYNC_GAMES_API_KEY,
# OBJECT_STORAGE_ACCESS_KEY, OBJECT_STORAGE_SECRET_KEY, MINIO_LICENSE_PATH.
# DNS A/AAAA records for DOMAIN and s3.DOMAIN must point to the VPS.
# API_PORT is optional and only controls the loopback-only host mapping.
DOMAIN=savecloud.example.com
S3_PUBLIC_ENDPOINT=https://s3.savecloud.example.com
SYNC_GAMES_API_KEY=<long-random-api-key>
OBJECT_STORAGE_ACCESS_KEY=<minio-user>
OBJECT_STORAGE_SECRET_KEY=<long-random-minio-secret>
MINIO_LICENSE_PATH=/absolute/path/to/minio.license
API_PORT=3000
