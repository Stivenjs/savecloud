# Plantilla para desarrollo, despliegues en AWS y herramientas de SaveCloud.
# Para autohospedar con Docker, usa .env.docker.example y scripts/docker-setup.

# Clave de la API que usa Serverless y que necesita la CLI para conectarse.
SYNC_GAMES_API_KEY=replace-with-a-random-api-key
# Secreto distinto para firmar las sesiones de usuarios invitados.
ACCESS_TOKEN_SECRET=replace-with-a-different-random-signing-secret

# Valores de almacenamiento para AWS.
AWS_REGION=us-east-2
BUCKET_NAME=savecloud-saves

# URL y credencial que se integran en el ejecutable de la CLI.
SYNC_GAMES_API_URL=http://localhost:3000
USE_ACCELERATE_ENDPOINT=false

# Opcional: puerto para ejecutar la API directamente con bun run dev.
PORT=3000
# Si activas autenticación al ejecutar la API directamente, usa el mismo valor que SYNC_GAMES_API_KEY.
# API_KEY=replace-with-the-same-api-key
