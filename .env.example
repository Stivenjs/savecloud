AWS_REGION=<your-aws-region>
PORT=3000
SYNC_GAMES_API_URL=<your-api-url>
SYNC_GAMES_API_KEY=<your-api-key>
ACCESS_TOKEN_SECRET=<different-long-random-token-signing-secret>
USE_ACCELERATE_ENDPOINT=false

# Docker Compose: copy .env.docker.example to .env and set all values below.
# Required for public HTTPS: DOMAIN, S3_PUBLIC_ENDPOINT, SYNC_GAMES_API_KEY, ACCESS_TOKEN_SECRET,
# OBJECT_STORAGE_ACCESS_KEY, OBJECT_STORAGE_SECRET_KEY, DATABASE_PASSWORD, MINIO_LICENSE_PATH.
# Traditional VPS mode: DNS A/AAAA records for DOMAIN and s3.DOMAIN point to the VPS.
# Cloudflare Tunnel mode: set CLOUDFLARE_TUNNEL_TOKEN and configure both hostnames to http://caddy:80;
# use docker-compose.cloudflare.yml. No inbound firewall ports or host port mappings are required.
# API_PORT is optional and only controls the local-only mapping in traditional/local mode.
DOMAIN=savecloud.example.com
# Selects the Compose deployment workflow: local, vps, or cloudflare.
DEPLOYMENT_MODE=vps
S3_PUBLIC_ENDPOINT=https://s3.savecloud.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
OBJECT_STORAGE_ACCESS_KEY=<minio-user>
OBJECT_STORAGE_SECRET_KEY=<long-random-minio-secret>
DATABASE_PASSWORD=<long-random-postgres-secret>
MINIO_LICENSE_PATH=/absolute/path/to/minio.license
API_PORT=3000
