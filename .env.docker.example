
# Clave API requerida para la app de escritorio y la CLI
SYNC_GAMES_API_KEY=replace-with-a-long-random-api-key
OBJECT_STORAGE_ACCESS_KEY=replace-with-a-minio-user
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-minio-secret
MINIO_LICENSE_PATH=./minio.license

# VPS: obligatoria. Caddy obtiene y renueva automáticamente el certificado para
# este dominio y s3.<DOMAIN>. Crea DNS A/AAAA para ambos nombres hacia el VPS.
# Desarrollo local: deja el valor por defecto que usa Compose (localhost).
DOMAIN=savecloud.example.com

# VPS: endpoint HTTPS público usado en URLs S3 presignadas por los clientes.
# Debe coincidir con el sitio s3.<DOMAIN> configurado en Caddy.
S3_PUBLIC_ENDPOINT=https://s3.savecloud.example.com

# Los endpoints internos S3/DynamoDB y las tablas están definidos en
# docker-compose.yml como nombres de servicio Docker; no necesitan overrides.

# Opcional: puerto de loopback para conservar http://localhost:3000 en desarrollo.
# No se publica en una interfaz de red pública.
API_PORT=3000
# Caddy runs on the Compose bridge network. Override this if you customize the network subnet.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
SEED_INTERVAL_MS=120000

# Nivel y solicitudes HTTP en los registros de la API.
LOG_LEVEL=warn
HTTP_REQUEST_LOGS=false
DYNAMODB_OPERATION_METRICS=false
