# Plantilla para todos los modos de autohospedaje con Docker.
# Ejecuta scripts/docker-setup.ps1 (Windows) o bash scripts/docker-setup.sh (Linux/macOS).
# El asistente completa o genera los secretos de ejemplo y elige los archivos Compose correctos.

# 1. Credenciales de SaveCloud. No las compartas ni las subas a Git.
SYNC_GAMES_API_KEY=replace-with-a-random-api-key
ACCESS_TOKEN_SECRET=replace-with-a-different-random-signing-secret

# 2. Modo de despliegue y direcciones.
# El asistente establece estos valores. Si vas a usar Compose manualmente, elige local, vps o cloudflare.
DEPLOYMENT_MODE=local
DOMAIN=localhost
S3_PUBLIC_ENDPOINT=http://localhost:9000
API_PORT=3000

# 3. Solo para Cloudflare Tunnel. Pega el token en el asistente, no el comando Docker completo.
# El túnel usa dos nombres: DOMAIN y s3.DOMAIN; ambos apuntan a http://caddy:80.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# 4. Almacenamiento local con MinIO AIStor.
OBJECT_STORAGE_ACCESS_KEY=replace-with-a-minio-user
OBJECT_STORAGE_SECRET_KEY=replace-with-a-random-minio-secret
MINIO_LICENSE_PATH=./minio.license

# 5. Base de datos y red privada.
DATABASE_PASSWORD=replace-with-a-random-postgres-secret
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# 6. Registros y workers (valores predeterminados recomendados).
LOG_LEVEL=warn
HTTP_REQUEST_LOGS=false
SEED_DETAILS_INTERVAL_MS=30000
SEED_REVIEWS_INTERVAL_MS=120000
STEAM_MIN_REQUEST_INTERVAL_MS=4000
REVIEWS_MIN_REQUEST_INTERVAL_MS=3000
