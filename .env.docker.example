
# Clave API requerida para la app de escritorio y la CLI
SYNC_GAMES_API_KEY=replace-with-a-long-random-api-key
ACCESS_TOKEN_SECRET=replace-with-a-different-long-random-token-signing-secret
OBJECT_STORAGE_ACCESS_KEY=replace-with-a-minio-user
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-minio-secret
DATABASE_PASSWORD=replace-with-a-long-random-postgres-secret
MINIO_LICENSE_PATH=./minio.license

# Dominio base: API en DOMAIN y S3 en s3.<DOMAIN>.
# Modo VPS tradicional: Caddy obtiene certificados y los registros DNS apuntan al VPS.
# Modo Cloudflare Tunnel: agrega ambos hostnames como Public Hostnames del túnel;
# Caddy usa Caddyfile.cloudflare y Cloudflare termina HTTPS.
# Desarrollo local: deja el valor por defecto que usa Compose (localhost).
DOMAIN=savecloud.example.com
# docker-setup also saves one of: local, vps, cloudflare.
DEPLOYMENT_MODE=vps

# Endpoint HTTPS público usado en URLs S3 presignadas por los clientes.
# Debe coincidir con el hostname s3.<DOMAIN> del Caddyfile y Cloudflare Tunnel.
S3_PUBLIC_ENDPOINT=https://s3.savecloud.example.com

# Cloudflare Tunnel remoto (opcional): solo se usa con
# docker-compose.cloudflare.yml. Crea el túnel y guarda su token aquí en .env.
# El archivo .env está excluido de Git; en Linux/macOS protege sus permisos (chmod 600 .env).
CLOUDFLARE_TUNNEL_TOKEN=

# Los endpoints internos S3/DynamoDB/PostgreSQL están definidos en docker-compose.yml.
# El asistente scripts/docker-setup genera DATABASE_PASSWORD si se deja este valor de ejemplo.

# Opcional: puerto de loopback para acceder a la API desde el host (local/VPS).
# El modo Cloudflare Tunnel elimina esta publicación junto con las de MinIO y Caddy.
API_PORT=3000
# Caddy runs on the Compose bridge network. Override this if you customize the network subnet.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
SEED_DETAILS_INTERVAL_MS=30000
SEED_REVIEWS_INTERVAL_MS=120000
STEAM_MIN_REQUEST_INTERVAL_MS=4000
REVIEWS_MIN_REQUEST_INTERVAL_MS=3000

# Nivel y solicitudes HTTP en los registros de la API.
LOG_LEVEL=warn
HTTP_REQUEST_LOGS=false
DYNAMODB_OPERATION_METRICS=false
