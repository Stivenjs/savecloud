[
  {
    "id": "ryujinx",
    "name": "Ryujinx",
    "console": "Nintendo Switch",
    "developer": "Ryubing",
    "description": {
      "es": "Emulador de Nintendo Switch de código abierto con soporte de gestión de partidas en SaveCloud.",
      "en": "Open-source Nintendo Switch emulator with save management support in SaveCloud."
    },
    "imageUrl": "/emulators/ryujinx.svg",
    "websiteUrl": "https://ryujinx.app",
    "downloadUrl": "https://git.ryujinx.app/ryubing/ryujinx/-/releases",
    "releaseAssets": {
      "windows": {
        "apiUrl": "https://git.ryujinx.app/api/v1/repos/Ryubing/Ryujinx/releases/latest",
        "nameIncludes": ["win", "x64"],
        "extension": ".zip",
        "artifactType": "archive"
      },
      "macos": {
        "apiUrl": "https://git.ryujinx.app/api/v1/repos/Ryubing/Ryujinx/releases/latest",
        "nameIncludes": ["macos"],
        "extension": ".zip",
        "artifactType": "archive"
      },
      "linux": {
        "apiUrl": "https://git.ryujinx.app/api/v1/repos/Ryubing/Ryujinx/releases/latest",
        "nameIncludes": ["linux", "x64"],
        "extension": ".tar.gz",
        "artifactType": "archive"
      }
    },
    "supportedPlatforms": ["Windows", "macOS", "Linux"],
    "executableNames": ["Ryujinx.exe", "Ryujinx"],
    "executableSearchPaths": {
      "windows": [
        "%APPDATA%/Ryujinx/publish/Ryujinx.exe",
        "%APPDATA%/Ryujinx/Ryujinx.exe",
        "%LOCALAPPDATA%/Ryujinx/publish/Ryujinx.exe",
        "%LOCALAPPDATA%/Ryujinx/Ryujinx.exe"
      ],
      "macos": [
        "/Applications/Ryujinx.app/Contents/MacOS/Ryujinx",
        "~/Applications/Ryujinx.app/Contents/MacOS/Ryujinx"
      ],
      "linux": ["/usr/bin/ryujinx", "/usr/local/bin/ryujinx"]
    },
    "savePaths": {
      "windows": ["%APPDATA%/Ryujinx/bis/user/save"],
      "macos": ["~/Library/Application Support/Ryujinx/bis/user/save"],
      "linux": ["~/.config/Ryujinx/bis/user/save"]
    },
    "portableSavePath": "portable/bis/user/save",
    "launchRules": [{ "extensions": ["nsp", "xci", "nsz"], "arguments": ["{file}"] }],
    "license": "MIT",
    "saveSyncSupported": true,
    "managedInstall": true
  },
