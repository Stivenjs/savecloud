{
  "name": "savecloud",
  "version": "1.12.8",
  "private": true,
  "bin": {
    "savecloud": "./src/cli/index.ts"
  },
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch src/interfaces/http/server.ts",
    "cli": "bun src/cli/index.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "api-key": "bun run scripts/generate-api-key.ts",
    "api-key:live": "bun run scripts/generate-api-key.ts -- --live",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:live": "serverless deploy --stage live",
    "deploy:steam-seed:dev": "serverless deploy function -f steamSeedWorker --stage dev",
    "deploy:steam-seed:live": "serverless deploy function -f steamSeedWorker --stage live",
    "deploy:api:dev": "serverless deploy function -f api --stage dev",
    "deploy:api:live": "serverless deploy function -f api --stage live",
    "deploy:authorizer:dev": "serverless deploy function -f apiAuthorizer --stage dev",
    "deploy:authorizer:live": "serverless deploy function -f apiAuthorizer --stage live",
    "invoke:local": "serverless invoke local -f api",
    "logs:steam-seed:dev": "serverless logs -f steamSeedWorker --stage dev --tail",
    "logs:steam-seed:live": "serverless logs -f steamSeedWorker --stage live --tail",
    "lint": "eslint src --ext .ts",
    "desktop": "bun run --cwd apps/savecloud-desktop tauri dev",
    "desktop:dev": "bun run --cwd apps/savecloud-desktop dev",
    "desktop:build": "bun run --cwd apps/savecloud-desktop tauri build",
    "cargo:check": "bun run --cwd apps/savecloud-desktop/src-tauri cargo check",
    "cargo:clean": "bun run --cwd apps/savecloud-desktop/src-tauri cargo clean",
    "version": "bun run scripts/sync-version.ts",
    "format": "bunx prettier . --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@fastify/aws-lambda": "^4.0.0",
    "@fastify/cors": "^10.0.0",
    "@inquirer/prompts": "^8.3.0",
    "@sinclair/typebox": "^0.34.48",
    "fastify": "^5.0.0",
    "figlet": "^1.10.0",
    "figures": "^6.1.0",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.1",
    "serverless": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
