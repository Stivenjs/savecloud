{
  "name": "savecloud",
  "version": "26.8.23",
  "private": true,
  "packageManager": "bun",
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch apps/api/src/interfaces/http/server.ts",
    "cli": "bun apps/cli/index.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "api-key": "bun run scripts/generate-api-key.ts",
    "api-key:live": "bun run scripts/generate-api-key.ts -- --live",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:live": "serverless deploy --stage live",
    "invoke:local": "serverless invoke local -f api",
    "logs:api:dev": "serverless logs -f api --stage dev --tail",
    "logs:seed:dev": "serverless logs -f steamSeedWorker --stage dev --tail",
    "lint": "eslint src --ext .ts",
    "desktop": "bun run --cwd apps/desktop tauri dev",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop tauri build",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "cargo:check": "bun run --cwd apps/desktop/src-tauri cargo check",
    "cargo:clean": "bun run --cwd apps/desktop/src-tauri cargo clean",
    "cargo:build": "bun run --cwd apps/desktop/src-tauri cargo build",
    "cargo:clippy": "bun run --cwd apps/desktop/src-tauri cargo clippy",
    "version": "bun run scripts/sync-version.ts",
    "check:api": "tsc --noEmit",
    "check:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "check:desktop": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:changed": "bun run scripts/format-changed.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1115.0",
    "@aws-sdk/client-dynamodb": "^3.1115.0",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/lib-dynamodb": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@fastify/aws-lambda": "^4.1.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.0",
    "@inquirer/prompts": "^8.6.0",
    "@sinclair/typebox": "^0.34.52",
    "@smithy/node-http-handler": "^4.11.3",
    "fastify": "^5.12.1",
    "figlet": "^1.11.4",
    "figures": "^6.1.0",
    "p-limit": "^7.3.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/bun": "latest",
    "@types/node": "^25.9.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0",
    "serverless": "^4.41.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "axios": "^1.18.0",
    "brace-expansion": "^2.1.4",
    "fast-uri": "^3.1.5",
    "fast-xml-parser": "^5.7.0",
    "fast-xml-builder": "^1.1.7",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6"
  }
}
